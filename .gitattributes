# Keep LF in the working tree on every OS. Git for Windows checks text out with CRLF by default, and
# `sh` can't run scripts with CRLF (the examples, eval tasks and test fixtures are shell scripts and
# exact text). Countercheck itself handles CRLF in projects it checks (see the CRLF tests).
* text=auto eol=lf

# Oracle extract fixtures keep their Windows line endings: the recipe test checks they are handled.
recipes/oracle-to-snowflake/test/project/oracle/** -text
